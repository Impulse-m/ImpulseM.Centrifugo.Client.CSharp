<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Namespace and Assembly -->
    <RootNamespace>Centrifugal.Centrifuge</RootNamespace>
    <AssemblyName>Centrifugal.Centrifuge</AssemblyName>

    <!-- Package Information -->
    <PackageId>ImpulseM.Centrifuge</PackageId>
    <Version>0.1.0</Version>
    <Authors>Centrifugal Labs;ImpulseM</Authors>
    <Company>Centrifugal Labs;ImpulseM</Company>
    <Description>
      Official C# client SDK to communicate with Centrifugo and Centrifuge-based server from multiple environments.
      Supports Protobuf communication over WebSocket (primary) and HTTP-streaming (bidirectional emulation).
    </Description>
    <PackageProjectUrl>https://github.com/Impulse-m/ImpulseM.Centrifugo.Client.CSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Impulse-m/ImpulseM.Centrifugo.Client.CSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>centrifugo;centrifuge;websocket;real-time;messaging;protobuf;streaming</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Required for Blazor static assets -->
    <StaticWebAssetBasePath>_content/Centrifugal.Centrifuge</StaticWebAssetBasePath>

    <!-- SourceLink is built into the .NET SDK (8.0.100+), no package reference needed -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Centrifugal.Centrifuge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Protobuf support - allow minor/patch updates -->
    <PackageReference Include="Google.Protobuf" Version="3.25.1" />

    <!-- Logging abstractions for idiomatic .NET logging support -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="6.0.0" />

    <!-- DI abstractions for Blazor WASM support -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="6.0.0" />

    <!-- JSInterop for Blazor WASM support -->
    <PackageReference Include="Microsoft.JSInterop" Version="6.0.0" />

    <!-- Public API surface check: PublicAPI.Shipped.txt and PublicAPI.Unshipped.txt -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../icon.png" Pack="true" PackagePath="/" Condition="Exists('../../icon.png')" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" Condition="Exists('../../LICENSE')" />
    <None Include="../../THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="/" Condition="Exists('../../THIRD_PARTY_NOTICES.md')" />
  </ItemGroup>

  <!-- NO Content Include for wwwroot -->
  <!-- Razor SDK handles wwwroot/** automatically as static web assets -->

</Project>
